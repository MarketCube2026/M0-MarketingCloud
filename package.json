{
  "name": "marketcube2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:github": "tsc -b && vite build --mode github-pages && node scripts/copy-spa-fallback.mjs",
